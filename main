RED = "\x1b[91m"
RESET = "\x1b[0m"


def enable_terminal_colors():
    if not sys.stdout.isatty() or not sys.stderr.isatty():
        return False
    if os.name != "nt":
        return True

    import ctypes

    kernel32 = ctypes.windll.kernel32
    kernel32.GetStdHandle.restype = ctypes.c_void_p
    stderr_handle = kernel32.GetStdHandle(-12)
    mode = ctypes.c_uint()
    kernel32.GetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint)]
    kernel32.SetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.c_uint]
    if not kernel32.GetConsoleMode(stderr_handle, ctypes.byref(mode)):
        return False
    return bool(kernel32.SetConsoleMode(stderr_handle, mode.value | 0x0004))


class TerminalFormatter(logging.Formatter):
    LEVEL_COLORS = {
        logging.DEBUG: "\x1b[90m",
        logging.INFO: "\x1b[37m",
        logging.WARNING: "\x1b[93m",
        logging.ERROR: "\x1b[91m",
        logging.CRITICAL: "\x1b[1;91m",
    }

    def __init__(self, colors_enabled):
        super().__init__("%(asctime)s - %(name)s - %(levelname)s - %(message)s")
        self.colors_enabled = colors_enabled

    def format(self, record):
        message = super().format(record)
        if not self.colors_enabled:
            return message
        color = self.LEVEL_COLORS.get(record.levelno, RESET)
        return f"{color}{message}{RESET}"


COLORS_ENABLED = enable_terminal_colors()
handler = logging.StreamHandler()
handler.setFormatter(TerminalFormatter(COLORS_ENABLED))
logging.basicConfig(level=logging.INFO, handlers=[handler], force=True)
logger = logging.getLogger(__name__)


def show_banner():
    if COLORS_ENABLED:
        print("\x1b[2J\x1b[H", end="")
    color = RED if COLORS_ENABLED else ""
    reset = RESET if COLORS_ENABLED else ""

    print(f"{color}+--------------------------------------------------+{reset}")
    print(f"|{color}{'S A G S S':^50}{reset}|")
    print(f"|{color}{'NUKE // DISCORD BOT':^50}{reset}|")
    print(f"|{'COMMUNITY TOOLS  -  ONLINE':^50}|")
    print(f"{color}+--------------------------------------------------+{reset}")
    print()


if __name__ == "__main__":
    show_banner()

