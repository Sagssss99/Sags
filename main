@bot.event
async def on_ready():
    logger.info(f"=== Sagss ===")
    logger.info(f"Conectado como: {bot.user}")
    logger.info(f"Servidores: {len(bot.guilds)}")
    logger.info("Usa ,help para ver los comandos.")

@bot.command(name="help", aliases=["comandos"])
async def help_command(ctx, *, command_name: str | None = None):
    if command_name:
        command = bot.get_command(command_name)
        if command is None:
            return await ctx.send(f"No encontré el comando `{command_name}`. Usa `,help` para ver la lista.")

        description = (
            command.help
            or command.brief
            or command.callback.__doc__
            or f"Comando de {command.qualified_name.replace('-', ' ')}."
        )
        syntax = f"{ctx.clean_prefix}{command.qualified_name}"
        example = syntax
        if command.signature:
            syntax = f"{syntax} {command.signature}"
        for name, parameter in command.clean_params.items():
            placeholder = f"<{name.replace('_', ' ')}>"
            if parameter.kind is parameter.KEYWORD_ONLY:
                example += f" {placeholder}"
                break
            if parameter.kind is parameter.VAR_POSITIONAL:
                example += f" {placeholder}..."
                continue
            if parameter.default is parameter.empty:
                example += f" {placeholder}"
            else:
                example += f" [{name.replace('_', ' ')}]"

        subcommands = None
        command_list = None
        if isinstance(command, commands.Group) and command.commands:
            subcommands = "\n".join(
                f"`{ctx.clean_prefix}{child.qualified_name}` — "
                f"{child.brief or child.help or child.qualified_name.replace('-', ' ')}"
                for child in command.commands
            )

        embed = command_help(
            bot,
            command=command.qualified_name,
            description=description,
            syntax=syntax,
            example=example,
            command_list=command_list,
            subcommands=subcommands,
        )
        return await ctx.send(embed=embed)

    command_names = {}
    for command in bot.walk_commands():
        command_names[command.qualified_name] = (
            command.brief
            or command.help
            or command.qualified_name.replace("-", " ").replace("_", " ")
        )
        for alias in command.aliases:
            parent = command.full_parent_name
            alias_name = f"{parent} {alias}" if parent else alias
            command_names[alias_name] = f"Alias de ,{command.qualified_name}"

    command_groups = {"commands": [], "voice_creator": []}
    for name, description in sorted(command_names.items()):
        group = "voice_creator" if name.startswith("voice") or name == "vc" else "commands"
        command_groups[group].append(f"`,{name}` — {description}")

    command_list = "\n".join(command_groups["commands"])
    voice_creator_commands = "\n".join(command_groups["voice_creator"])
    embed = command_help(
        bot,
        command="help",
        description="View all available commands for your community.",
        syntax="`,help (command)`",
        example="`,help ban`",
        command_list=command_list,
        voice_creator_commands=voice_creator_commands,
    )
    await ctx.send(embed=embed)

@bot.command()
async def helpme(ctx, *, command_name: str | None = None):
    await help_command(ctx, command_name=command_name)

