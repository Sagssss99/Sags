@bot.command(aliases=["serverinfo"])
async def server(ctx):
    guild = ctx.guild
    if guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    await ctx.send(
        f"**{guild.name}**\n"
        f"ID: `{guild.id}`\n"
        f"Miembros: `{guild.member_count}`\n"
        f"Canales: `{len(guild.channels)}`"
    )

@bot.command()
async def userinfo(ctx, member: discord.Member | None = None):
    member = member or ctx.author
    embed = discord.Embed(
        title=f"Nombres y avatares de {member}",
        color=0x5865F2,
    )
    embed.set_thumbnail(url=member.display_avatar.url)

    guild_history = PROFILE_HISTORY.get(str(ctx.guild.id), {}) if ctx.guild else {}
    snapshots = guild_history.get(str(member.id), [])
    names = []
    avatars = []
    for snapshot in snapshots:
        for key in ("name", "display_name"):
            value = snapshot.get(key)
            if value and (key, value) not in names:
                names.append((key, value))
        for key in ("avatar", "guild_avatar"):
            value = snapshot.get(key)
            if value and (key, value) not in avatars:
                avatars.append((key, value))

    name_lines = [
        f"**{'Usuario' if key == 'name' else 'Nombre visible'}:** `{value}`"
        for key, value in names[-8:]
    ]
    avatar_lines = [
        f"[{'Avatar' if key == 'avatar' else 'Avatar del servidor'}]({url})"
        for key, url in avatars[-8:]
    ]
    embed.add_field(
        name="Historial de nombres",
        value="\n".join(name_lines) or "Sin cambios registrados.",
        inline=False,
    )
    embed.add_field(
        name="Historial de avatares",
        value="\n".join(avatar_lines) or "Sin cambios registrados.",
        inline=False,
    )

    await ctx.send(embed=embed)


@bot.command(name="limpiarnombres")
@commands.has_guild_permissions(manage_nicknames=True)
async def clean_member_nicknames(ctx):
    guild = ctx.guild
    if guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")

    cleaned = 0
    failed = 0
    async for member in guild.fetch_members(limit=None):
        if not member.manageable or member.nick is None:
            continue
        try:
            await member.edit(
                nick=None,
                reason=f"Limpieza de nombres por {ctx.author} ({ctx.author.id})",
            )
            cleaned += 1
        except discord.HTTPException:
            failed += 1
            logger.exception(
                "No se pudo limpiar el apodo de %s en el servidor %s",
                member.id,
                guild.id,
            )

    embed = discord.Embed(
        title="Nombres limpiados",
        description=f"Se limpiaron **{cleaned}** apodos del servidor.",
        color=0x5865F2,
    )
    if failed:
        embed.add_field(
            name="No se pudieron limpiar",
            value=f"{failed} apodo(s). Revisa permisos y registros del bot.",
            inline=False,
        )
    await ctx.reply(embed=embed)


@bot.command(name="limpiaravatares")
async def list_custom_avatar_members(ctx):
    guild = ctx.guild
    if guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")

    members = [member async for member in guild.fetch_members(limit=None)]
    users = [member for member in members if member.avatar is not None]
    listing = "\n".join(member.mention for member in users[:50])

    embed = discord.Embed(
        title="Avatares detectados",
        description=listing or "No se encontraron usuarios con avatar personalizado.",
        color=0x5865F2,
    )
    embed.set_footer(text=f"{len(users)} usuarios detectados")
    await ctx.reply(embed=embed)


@bot.event
async def on_member_update(before, after):
    added_protected_roles = {
        role for role in after.roles
        if role.id in PROTECTED_ROLES
        and all(before_role.id != role.id for before_role in before.roles)
    }
    if added_protected_roles:
        protected_role_ids = {role.id for role in added_protected_roles}
        event_time = discord.utils.utcnow()
        actor_id = None
        for attempt in range(3):
            try:
                async for entry in after.guild.audit_logs(
                    limit=10,
                    action=discord.AuditLogAction.member_role_update,
                ):
                    if entry.created_at < event_time - timedelta(seconds=10):
                        break
                    if getattr(entry.target, "id", None) != after.id:
                        continue
                    added_roles = getattr(entry.changes.after, "roles", ())
                    if any(role.id in protected_role_ids for role in added_roles):
                        actor_id = entry.user_id
                        break
            except discord.HTTPException:
                logger.exception(
                    "No se pudo consultar el registro de auditoría para validar roles protegidos "
                    "de %s en el servidor %s",
                    after.id,
                    after.guild.id,
                )
                break
            if actor_id is not None:
                break
            if attempt < 2:
                await asyncio.sleep(0.6)

        bot_user_id = bot.user.id if bot.user else None
        if actor_id in ADMIN_WHITELIST or actor_id == bot_user_id:
            logger.info(
                "Rol(es) protegido(s) %s asignado(s) a %s por usuario autorizado %s",
                ", ".join(str(role.id) for role in added_protected_roles),
                after.id,
                actor_id,
            )
        else:
            try:
                await after.remove_roles(
                    *added_protected_roles,
                    reason=(
                        "Rol protegido asignado sin autorización de whitelist "
                        f"(actor {actor_id if actor_id is not None else 'no identificado'})"
                    ),
                )
                logger.warning(
                    "Se quitaron roles protegidos %s de %s: actor no autorizado (%s)",
                    ", ".join(str(role.id) for role in added_protected_roles),
                    after.id,
                    actor_id,
                )
            except discord.HTTPException:
                logger.exception(
                    "No se pudieron quitar los roles protegidos %s de %s; "
                    "comprueba permisos y jerarquía del bot",
                    ", ".join(str(role.id) for role in added_protected_roles),
                    after.id,
                )

    profile_fields = ("name", "display_name")
    changed = any(
        getattr(before, field) != getattr(after, field)
        for field in profile_fields
    ) or before.avatar != after.avatar or before.guild_avatar != after.guild_avatar
    if not changed:
        return

    guild_history = PROFILE_HISTORY.setdefault(str(after.guild.id), {})
    snapshots = guild_history.setdefault(str(after.id), [])
    timestamp = discord.utils.utcnow().isoformat()

    def snapshot(member):
        return {
            "at": timestamp,
            "name": member.name,
            "display_name": member.display_name,
            "avatar": member.avatar.url if member.avatar else None,
            "guild_avatar": member.guild_avatar.url if member.guild_avatar else None,
        }

    if not snapshots:
        snapshots.append(snapshot(before))
    snapshots.append(snapshot(after))
    del snapshots[:-21]
    try:
        save_profile_history()
    except OSError:
        logger.exception("No se pudo guardar el historial de perfil de %s", after.id)
        raise

@bot.command()
async def avatar(ctx, member: discord.Member | None = None):
    member = member or ctx.author
    await ctx.send(member.display_avatar.url)

@bot.command()
async def roles(ctx):
    guild = ctx.guild
    if guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")

    guild_roles = sorted(
        (role for role in guild.roles if role.id != guild.id),
        key=lambda role: role.position,
        reverse=True,
    )
    page_size = 10
    page = 1
    start = (page - 1) * page_size
    page_roles = guild_roles[start:start + page_size]
    role_list = "\n".join(
        f"{index}. {role.mention}"
        for index, role in enumerate(page_roles, start=start + 1)
    )
    total_pages = max(1, (len(guild_roles) + page_size - 1) // page_size)

    embed = discord.Embed(
        title="Roles",
        description=role_list or "No hay roles.",
        color=0x5865F2,
    )
    author = {"name": "Sags"}
    if guild.icon:
        author["icon_url"] = guild.icon.url
    embed.set_author(**author)
    embed.set_footer(
        text=f"Page {page}/{total_pages} ({len(guild_roles)} entries)"
    )

    await ctx.send(embed=embed)

@bot.command()
async def channels(ctx):
    guild = ctx.guild
    if guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    text_channels = ", ".join(channel.name for channel in guild.text_channels) or "Sin canales de texto"
    voice_channels = ", ".join(channel.name for channel in guild.voice_channels) or "Sin canales de voz"
    await ctx.send(f"**Canales de texto:**\n{text_channels}\n\n**Canales de voz:**\n{voice_channels}")

@bot.command()
async def invite(ctx):
    invite = await ctx.channel.create_invite(max_age=3600, max_uses=1)
    await ctx.send(f"**Invitación:** {invite.url}")

@bot.command()
async def poll(ctx, *, question: str):
    await ctx.send(f"📊 **Encuesta**\n{question}\n\n👍 Sí  |  👎 No")

@bot.command()
async def say(ctx, *, message: str):
    if ctx.author.guild_permissions.manage_messages:
        await ctx.message.delete()
    await ctx.send(message)

@bot.command()
async def announce(ctx, *, message: str):
    if not ctx.author.guild_permissions.manage_guild:
        return await ctx.send("No tienes permisos para usar este comando.")
    await ctx.send(f"@everyone\n📢 **Anuncio**\n{message}")

@bot.command()
async def clear(ctx, amount: int = 5):
    if not ctx.author.guild_permissions.manage_messages:
        return await ctx.send("No tienes permisos para borrar mensajes.")
    amount = max(1, min(amount, 100))
    deleted = await ctx.channel.purge(limit=amount)
    await ctx.send(f"He borrado `{len(deleted)}` mensajes.", delete_after=3)


async def can_manage_voice_creators(ctx):
    if ctx.guild is None:
        await ctx.send("Este comando solo puede usarse dentro de un servidor.")
        return False
    allowed = (
        ctx.author.id == ctx.guild.owner_id
        or ctx.author.id in VOICE_CREATOR_ALLOWLIST.get(ctx.guild.id, set())
    )
    if not allowed:
        await ctx.send(
            "No estás en la whitelist para administrar voice creators. "
            "Pide al propietario o a alguien con Gestionar canales que te agregue."
        )
    return allowed


def public_voice_overwrites(guild, category):
    overwrites = category.overwrites
    everyone = overwrites.get(guild.default_role, discord.PermissionOverwrite())
    everyone.view_channel = True
    everyone.connect = True
    overwrites[guild.default_role] = everyone
    return overwrites


@bot.command(name="voicecreate", aliases=["voice-create"])
@commands.check(can_manage_voice_creators)
async def voicecreate(ctx, *, name: str = "Canal de voz"):
    if ctx.guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    channel = await ctx.guild.create_voice_channel(name=name)
    await ctx.send(f"✅ Canal de voz creado: {channel.mention}")


@bot.group(name="voicecreator", invoke_without_command=True)
async def voicecreator(ctx):
    await ctx.send(
        "Usa `,voicecreator add <categoria> [nombre]`, "
        "`,voicecreator list`, `,voicecreator allow @usuario`, "
        "`,voicecreator deny @usuario` o `,voicecreator whitelist`."
    )


@voicecreator.command(name="add")
@commands.check(can_manage_voice_creators)
async def voicecreator_add(
    ctx,
    category: discord.CategoryChannel,
    *,
    name: str = "➕ Crear canal",
):
    if ctx.guild is None or category.guild.id != ctx.guild.id:
        return await ctx.send("La categoría debe pertenecer a este servidor.")

    channel = await ctx.guild.create_voice_channel(
        name=name[:100],
        category=category,
        overwrites=public_voice_overwrites(ctx.guild, category),
        reason=f"Voice creator configurado por {ctx.author}",
    )
    creators = VOICE_CREATORS.setdefault(ctx.guild.id, set())
    creators.add(channel.id)
    try:
        save_voice_creator_config()
    except OSError as error:
        creators.discard(channel.id)
        if not creators:
            VOICE_CREATORS.pop(ctx.guild.id, None)
        await channel.delete(reason="No se pudo guardar la configuración del voice creator")
        logger.exception("No se pudo guardar la configuración del voice creator")
        return await ctx.send(f"No pude guardar la configuración: `{error}`")

    await ctx.send(
        f"✅ Voice creator creado en **{category.name}**: {channel.mention}\n"
        "Cualquier miembro puede entrar al canal disparador para crear su sala."
    )


@voicecreator.command(name="allow")
@commands.has_permissions(manage_channels=True)
async def voicecreator_allow(ctx, member: discord.Member):
    if ctx.guild is None or member.guild.id != ctx.guild.id:
        return await ctx.send("El usuario debe pertenecer a este servidor.")
    if member.bot:
        return await ctx.send("No se pueden autorizar bots para usar el voice creator.")
    allowlist = VOICE_CREATOR_ALLOWLIST.setdefault(ctx.guild.id, set())
    was_allowed = member.id in allowlist
    allowlist.add(member.id)
    try:
        save_voice_creator_config()
    except OSError as error:
        if not was_allowed:
            allowlist.discard(member.id)
        if not allowlist:
            VOICE_CREATOR_ALLOWLIST.pop(ctx.guild.id, None)
        logger.exception("No se pudo guardar la whitelist del voice creator")
        return await ctx.send(f"No pude guardar el cambio: `{error}`")
    await ctx.send(f"✅ {member.mention} puede administrar los comandos del voice creator.")


@voicecreator.command(name="deny")
@commands.has_permissions(manage_channels=True)
async def voicecreator_deny(ctx, member: discord.Member):
    if ctx.guild is None or member.guild.id != ctx.guild.id:
        return await ctx.send("El usuario debe pertenecer a este servidor.")
    allowlist = VOICE_CREATOR_ALLOWLIST.get(ctx.guild.id, set())
    if member.id not in allowlist:
        return await ctx.send(f"{member.mention} no estaba en la whitelist.")
    allowlist.remove(member.id)
    if not allowlist:
        VOICE_CREATOR_ALLOWLIST.pop(ctx.guild.id, None)
    try:
        save_voice_creator_config()
    except OSError as error:
        VOICE_CREATOR_ALLOWLIST.setdefault(ctx.guild.id, set()).add(member.id)
        logger.exception("No se pudo guardar la whitelist del voice creator")
        return await ctx.send(f"No pude guardar el cambio: `{error}`")
    await ctx.send(f"✅ {member.mention} ya no puede administrar los comandos del voice creator.")


@voicecreator.command(name="whitelist")
@commands.has_permissions(manage_channels=True)
async def voicecreator_whitelist(ctx):
    if ctx.guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    member_ids = sorted(VOICE_CREATOR_ALLOWLIST.get(ctx.guild.id, set()))
    if not member_ids:
        return await ctx.send(
            "La whitelist está vacía. Solo el propietario puede administrar los creators. "
            "Añade usuarios con `,voicecreator allow @usuario`."
        )
    entries = [f"• <@{member_id}>" for member_id in member_ids[:50]]
    suffix = f"\n… y {len(member_ids) - 50} más." if len(member_ids) > 50 else ""
    await ctx.send("**Whitelist de voice creator:**\n" + "\n".join(entries) + suffix)


@voicecreator.command(name="list")
async def voicecreator_list(ctx):
    if ctx.guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")

    channel_ids = VOICE_CREATORS.get(ctx.guild.id, set())
    channels = [
        ctx.guild.get_channel(channel_id)
        for channel_id in sorted(channel_ids)
    ]
    channels = [channel for channel in channels if channel is not None]
    if not channels:
        return await ctx.send("No hay voice creators configurados en este servidor.")

    lines = [
        f"• {channel.mention} — {channel.category.name if channel.category else 'Sin categoría'}"
        for channel in channels
    ]
    await ctx.send("**Voice creators configurados:**\n" + "\n".join(lines))


@voicecreator.command(name="remove")
@commands.check(can_manage_voice_creators)
async def voicecreator_remove(ctx, channel: discord.VoiceChannel):
    if ctx.guild is None or channel.guild.id != ctx.guild.id:
        return await ctx.send("El canal debe pertenecer a este servidor.")

    creators = VOICE_CREATORS.get(ctx.guild.id, set())
    if channel.id not in creators:
        return await ctx.send("Ese canal no está configurado como voice creator.")

    creators.remove(channel.id)
    if not creators:
        VOICE_CREATORS.pop(ctx.guild.id, None)
    try:
        save_voice_creator_config()
    except OSError as error:
        VOICE_CREATORS.setdefault(ctx.guild.id, set()).add(channel.id)
        logger.exception("No se pudo guardar la configuración del voice creator")
        return await ctx.send(f"No pude guardar el cambio: `{error}`")

    await ctx.send(f"✅ {channel.mention} ya no creará canales. El canal no fue eliminado.")


def _member_voice_channel(ctx):
    if ctx.author.voice is None or ctx.author.voice.channel is None:
        return None
    return ctx.author.voice.channel


def _can_manage_temp_voice(ctx, channel):
    owner_id = VOICE_CHANNEL_OWNERS.get(ctx.guild.id, {}).get(channel.id)
    return (
        ctx.author.id == ctx.guild.owner_id
        or ctx.author.guild_permissions.administrator
        or ctx.author.guild_permissions.manage_channels
        or owner_id == ctx.author.id
    )


@bot.command(name="voice")
async def voice_info(ctx, member: discord.Member = None):
    member = member or ctx.author
    if member.voice is None or member.voice.channel is None:
        return await ctx.send(f"{member.mention} no está en un canal de voz.")
    channel = member.voice.channel
    await ctx.send(
        f"{member.mention} está en {channel.mention} "
        f"({len(channel.members)} participante(s), límite {channel.user_limit or 'sin límite'})."
    )


@bot.command(name="voice-delete")
async def voice_delete(ctx):
    channel = _member_voice_channel(ctx)
    if channel is None:
        return await ctx.send("Entra a tu canal de voz temporal para borrarlo.")
    if channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Solo se pueden borrar canales temporales del voice creator.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede borrarlo.")
    await channel.delete(reason=f"Canal temporal eliminado por {ctx.author}")
    owners = VOICE_CHANNEL_OWNERS.get(ctx.guild.id, {})
    owners.pop(channel.id, None)
    temporary = TEMP_VOICE_CHANNELS[ctx.guild.id]
    temporary.discard(channel.id)
    if not temporary:
        TEMP_VOICE_CHANNELS.pop(ctx.guild.id, None)
    save_voice_creator_config()
    await ctx.send("✅ Canal temporal eliminado.")


@bot.command(name="voice-lock")
async def voice_lock(ctx):
    channel = _member_voice_channel(ctx)
    if channel is None or channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Entra a un canal temporal del voice creator para bloquearlo.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede bloquearlo.")
    await channel.set_permissions(ctx.guild.default_role, connect=False, reason=f"Bloqueado por {ctx.author}")
    await ctx.send("🔒 Canal de voz bloqueado.")


@bot.command(name="voice-unlock")
async def voice_unlock(ctx):
    channel = _member_voice_channel(ctx)
    if channel is None or channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Entra a un canal temporal del voice creator para desbloquearlo.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede desbloquearlo.")
    await channel.set_permissions(ctx.guild.default_role, connect=None, reason=f"Desbloqueado por {ctx.author}")
    await ctx.send("🔓 Canal de voz desbloqueado.")


@bot.command(name="voice-limit")
async def voice_limit(ctx, limit: int):
    channel = _member_voice_channel(ctx)
    if channel is None or channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Entra a un canal temporal del voice creator para cambiar el límite.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede cambiar el límite.")
    if not 0 <= limit <= 99:
        return await ctx.send("El límite debe estar entre 0 (sin límite) y 99.")
    await channel.edit(user_limit=limit, reason=f"Límite configurado por {ctx.author}")
    await ctx.send(f"✅ Límite actualizado: `{limit or 'sin límite'}`.")


@bot.command(name="voice-name")
async def voice_name(ctx, *, name: str):
    channel = _member_voice_channel(ctx)
    if channel is None or channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Entra a un canal temporal del voice creator para cambiar el nombre.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede renombrarlo.")
    await channel.edit(name=name[:100], reason=f"Renombrado por {ctx.author}")
    await ctx.send("✅ Nombre del canal actualizado.")


@bot.command(name="voice-kick")
async def voice_kick(ctx, member: discord.Member):
    channel = _member_voice_channel(ctx)
    if channel is None or member.voice is None or member.voice.channel != channel:
        return await ctx.send("El usuario debe estar en tu canal de voz.")
    if channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()) or not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede expulsar usuarios.")
    await member.move_to(None, reason=f"Expulsado del canal temporal por {ctx.author}")
    await ctx.send(f"✅ {member.mention} fue desconectado.")


@bot.command(name="voice-ban")
async def voice_ban(ctx, member: discord.Member):
    channel = _member_voice_channel(ctx)
    if channel is None or channel.id not in TEMP_VOICE_CHANNELS.get(ctx.guild.id, set()):
        return await ctx.send("Entra a un canal temporal del voice creator para bloquear a un usuario.")
    if not _can_manage_temp_voice(ctx, channel):
        return await ctx.send("Solo el creador del canal o un administrador puede bloquear usuarios.")
    await channel.set_permissions(member, connect=False, reason=f"Bloqueado por {ctx.author}")
    if member.voice and member.voice.channel == channel:
        await member.move_to(None, reason=f"Bloqueado por {ctx.author}")
    await ctx.send(f"✅ {member.mention} ya no puede entrar a este canal.")


@bot.event
async def on_voice_state_update(member, before, after):
    guild_id = member.guild.id

    if after.channel and after.channel.id in VOICE_CREATORS.get(guild_id, set()):
        category = after.channel.category
        if category is None:
            logger.error("El canal creator %s no tiene categoría", after.channel.id)
            return

        channel = await member.guild.create_voice_channel(
            name=f"{member.display_name} - canal",
            category=category,
            overwrites=public_voice_overwrites(member.guild, category),
            reason=f"Canal temporal para {member}",
        )
        temporary = TEMP_VOICE_CHANNELS.setdefault(guild_id, set())
        temporary.add(channel.id)
        owners = VOICE_CHANNEL_OWNERS.setdefault(guild_id, {})
        owners[channel.id] = member.id
        try:
            save_voice_creator_config()
            await member.move_to(channel, reason="Entrada al voice creator")
        except (OSError, discord.HTTPException) as error:
            temporary.discard(channel.id)
            owners.pop(channel.id, None)
            if not temporary:
                TEMP_VOICE_CHANNELS.pop(guild_id, None)
            try:
                await channel.delete(reason="Falló la configuración o el traslado del voice creator")
            except discord.HTTPException:
                logger.exception("No se pudo eliminar el canal temporal fallido %s", channel.id)
            if isinstance(error, OSError):
                logger.exception("No se pudo guardar el canal temporal del voice creator")
            else:
                logger.error("No se pudo mover a %s al canal temporal: %s", member, error)
            return

    if before.channel and before.channel.id in TEMP_VOICE_CHANNELS.get(guild_id, set()):
        if not before.channel.members:
            temporary = TEMP_VOICE_CHANNELS[guild_id]
            temporary.discard(before.channel.id)
            VOICE_CHANNEL_OWNERS.get(guild_id, {}).pop(before.channel.id, None)
            if not temporary:
                TEMP_VOICE_CHANNELS.pop(guild_id, None)
            try:
                await before.channel.delete(reason="Canal temporal vacío")
                save_voice_creator_config()
            except (OSError, discord.HTTPException):
                logger.exception("No se pudo limpiar el canal temporal %s", before.channel.id)


def is_admin_whitelisted(ctx):
    return ctx.guild is not None and ctx.author.id in ADMIN_WHITELIST


def bot_has_permission(guild, permission):
    bot_member = guild.me
    return bot_member is not None and getattr(bot_member.guild_permissions, permission)


@bot.command(name="protectrole", aliases=["protectadmin"])
async def protect_role(ctx, role: discord.Role):
    if ctx.author.id != ROOT_ADMIN_ID:
        return await ctx.send("⚠️ Solo el administrador raíz puede proteger roles.")
    if ctx.guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    if role.guild != ctx.guild:
        return await ctx.send("⚠️ El rol debe pertenecer a este servidor.")
    if role.is_default() or role.managed:
        return await ctx.send("⚠️ No se puede proteger @everyone ni roles administrados por integraciones.")
    if not bot_has_permission(ctx.guild, "manage_roles"):
        return await ctx.send("⚠️ Necesito el permiso Gestionar roles para hacer cumplir esta protección.")
    if ctx.guild.me is None or role >= ctx.guild.me.top_role:
        return await ctx.send("⚠️ Mi rol más alto debe estar por encima del rol protegido.")

    already_protected = role.id in PROTECTED_ROLES
    PROTECTED_ROLES.add(role.id)
    try:
        save_admin_access_config()
    except OSError as error:
        if not already_protected:
            PROTECTED_ROLES.discard(role.id)
        logger.exception("No se pudo guardar el rol protegido %s", role.id)
        return await ctx.send(f"⚠️ No se pudo guardar el rol: `{error}`")

    await ctx.send(
        f"✅ El rol `{role.name}` está protegido: solo la whitelist puede asignarlo."
    )


@bot.command(name="unprotectrole", aliases=["unprotectadmin"])
async def unprotect_role(ctx, role: discord.Role):
    if ctx.author.id != ROOT_ADMIN_ID:
        return await ctx.send("⚠️ Solo el administrador raíz puede quitar protecciones.")
    if ctx.guild is None:
        return await ctx.send("Este comando debe usarse dentro de un servidor.")
    if role.guild != ctx.guild:
        return await ctx.send("⚠️ El rol debe pertenecer a este servidor.")
    if role.id not in PROTECTED_ROLES:
        return await ctx.send(f"⚠️ El rol `{role.name}` no está protegido.")

    PROTECTED_ROLES.remove(role.id)
    try:
        save_admin_access_config()
    except OSError as error:
        PROTECTED_ROLES.add(role.id)
        logger.exception("No se pudo quitar la protección del rol %s", role.id)
        return await ctx.send(f"⚠️ No se pudo guardar el cambio: `{error}`")

    await ctx.send(f"✅ El rol `{role.name}` ya no está protegido.")

@bot.command(name="addadminuser")
async def addadminuser(ctx, member: discord.Member):
    if ctx.author.id != ROOT_ADMIN_ID:
        return await ctx.send("⚠️ Solo el administrador raíz configurado puede modificar la whitelist global.")
    was_whitelisted = member.id in ADMIN_WHITELIST
    ADMIN_WHITELIST.add(member.id)
    try:
        save_admin_access_config()
    except OSError as error:
        if not was_whitelisted and member.id != ROOT_ADMIN_ID:
            ADMIN_WHITELIST.discard(member.id)
        logger.exception("No se pudo guardar la whitelist de administración")
        return await ctx.send(f"⚠️ No se pudo guardar la whitelist: `{error}`")
    await ctx.send(f"✅ `{member}` fue añadido a la whitelist de administración.")

@bot.command(name="removeadminuser")
async def removeadminuser(ctx, member: discord.Member):
    if ctx.author.id != ROOT_ADMIN_ID:
        return await ctx.send("⚠️ Solo el administrador raíz configurado puede modificar la whitelist global.")
    if member.id == ROOT_ADMIN_ID:
        return await ctx.send("⚠️ No puedes quitar al administrador raíz de la whitelist.")
    was_whitelisted = member.id in ADMIN_WHITELIST
    ADMIN_WHITELIST.discard(member.id)
    try:
        save_admin_access_config()
    except OSError as error:
        if was_whitelisted:
            ADMIN_WHITELIST.add(member.id)
        logger.exception("No se pudo guardar la whitelist de administración")
        return await ctx.send(f"⚠️ No se pudo guardar la whitelist: `{error}`")
    await ctx.send(f"✅ `{member}` fue quitado de la whitelist de administración.")

@bot.command(name="grantadmin")
async def grantadmin(ctx, member: discord.Member, role: discord.Role):
    if not is_admin_whitelisted(ctx):
        return await ctx.send("⚠️ Solo los usuarios autorizados de la whitelist pueden asignar roles administrativos protegidos.")
    if role.guild != ctx.guild or member.guild != ctx.guild:
        return await ctx.send("⚠️ El usuario y el rol deben pertenecer a este servidor.")
    if role.id not in PROTECTED_ROLES:
        return await ctx.send(f"⚠️ El rol `{role.name}` no está protegido.")
    if member.id == ctx.guild.owner_id:
        return await ctx.send("⚠️ No puedes modificar los roles del propietario del servidor.")
    if role in member.roles:
        return await ctx.send(f"⚠️ `{member}` ya tiene el rol `{role.name}`.")
    await member.add_roles(role)
    await ctx.send(f"✅ Se asignó el rol `{role.name}` a `{member}`.")


@bot.command(name="unti")
async def remove_all_timeouts(ctx):
    if not is_admin_whitelisted(ctx):
        return await ctx.send("⚠️ Solo usuarios de la whitelist pueden usar este comando.")
    guild = ctx.guild
    if not bot_has_permission(guild, "moderate_members"):
        return await ctx.send("⚠️ El bot necesita el permiso Moderar miembros para quitar aislamientos.")

    removed = 0
    failed = 0
    fetch_failed = False
    try:
        async for member in guild.fetch_members(limit=None):
            until = member.timed_out_until
            if until is None or until <= discord.utils.utcnow():
                continue
            try:
                await member.timeout(
                    None,
                    reason=f"Un-ti solicitado por {ctx.author} ({ctx.author.id})",
                )
                removed += 1
            except discord.HTTPException:
                failed += 1
                logger.exception(
                    "No se pudo quitar el timeout de %s en el servidor %s",
                    member.id,
                    guild.id,
                )
    except discord.HTTPException:
        fetch_failed = True
        logger.exception("Falló la lectura completa de miembros para ,unti en %s", guild.id)

    embed = discord.Embed(
        title="Un-ti",
        description=f"Se quitaron **{removed}** aislamientos del servidor.",
        color=0x57F287,
    )
    if failed or fetch_failed:
        embed.add_field(name="Fallidos", value=str(failed), inline=False)
    if fetch_failed:
        embed.add_field(
            name="Proceso incompleto",
            value="Discord no permitió completar la lectura de miembros.",
            inline=False,
        )
    await ctx.reply(embed=embed)


@bot.command(name="unbanall")
async def unban_all_members(ctx):
    if not is_admin_whitelisted(ctx):
        return await ctx.send("⚠️ Solo usuarios de la whitelist pueden usar este comando.")
    guild = ctx.guild
    if not bot_has_permission(guild, "ban_members"):
        return await ctx.send("⚠️ El bot necesita el permiso Banear miembros para quitar baneos.")

    unbanned = 0
    failed = 0
    fetch_failed = False
    try:
        async for ban_entry in guild.bans(limit=None):
            try:
                await guild.unban(
                    ban_entry.user,
                    reason=f"Unbanall solicitado por {ctx.author} ({ctx.author.id})",
                )
                unbanned += 1
            except discord.HTTPException:
                failed += 1
                logger.exception(
                    "No se pudo quitar el baneo de %s en el servidor %s",
                    ban_entry.user.id,
                    guild.id,
                )
    except discord.HTTPException:
        fetch_failed = True
        logger.exception("Falló la lectura completa de baneos del servidor %s", guild.id)

    embed = discord.Embed(
        title="Unban All",
        description=f"Se quitaron **{unbanned}** baneos del servidor.",
        color=0x57F287,
    )
    if failed or fetch_failed:
        embed.add_field(name="Fallidos", value=str(failed), inline=False)
    if fetch_failed:
        embed.add_field(
            name="Proceso incompleto",
            value="Discord no permitió completar la lectura de baneos.",
            inline=False,
        )
    await ctx.reply(embed=embed)

from features import DATA, register_commands
from command_catalog import register_command_catalog


def configured_prefix(client, message):
    if message.guild is None:
        return ","
    return DATA.get(str(message.guild.id), {}).get("prefix", ",")


bot.command_prefix = configured_prefix
register_commands(bot)
register_command_catalog(bot)

async def run_bot():
    global TOKEN
    load_dotenv()
    TOKEN = os.getenv("DISCORD_TOKEN")
    if not TOKEN or TOKEN == "TU_TOKEN_DE_BOT":
        logger.error("DISCORD_TOKEN is missing or not configured")
        raise SystemExit("Configura DISCORD_TOKEN con un token nuevo en el archivo .env")
    logger.info("Running 1 bot")
    instance_lock = acquire_instance_lock()
    try:
        await bot.start(TOKEN)
    finally:
        try:
            await bot.close()
        finally:
            instance_lock.close()

if __name__ == "__main__":
    asyncio.run(run_bot())
