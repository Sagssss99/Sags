ADMIN_WHITELIST = {
    int(user_id.strip())
    for user_id in os.getenv("ADMIN_WHITELIST_IDS", "").split(",")
    if user_id.strip()
}
ROOT_ADMIN_ID = 1421710365439299676
ADMIN_WHITELIST.add(ROOT_ADMIN_ID)
PROTECTED_ROLES = {
    int(role_id.strip())
    for role_id in os.getenv("PROTECTED_ADMIN_ROLES", "").split(",")
    if role_id.strip()
}

VOICE_CREATOR_CONFIG = os.path.join(os.path.dirname(__file__), "data", "voice_creators.json")
INSTANCE_LOCK_PATH = os.path.join(os.path.dirname(__file__), "data", "bot.lock")
PROFILE_HISTORY_PATH = os.path.join(os.path.dirname(__file__), "data", "profile_history.json")
ADMIN_ACCESS_CONFIG = os.path.join(os.path.dirname(__file__), "data", "admin_access.json")


def load_admin_access_config():
    try:
        with open(ADMIN_ACCESS_CONFIG, encoding="utf-8") as config_file:
            config = json.load(config_file)
    except FileNotFoundError:
        return
    except (OSError, json.JSONDecodeError) as error:
        logger.error("No se pudo leer la configuración de administración: %s", error)
        raise

    if not isinstance(config, dict):
        raise ValueError("admin_access.json debe contener un objeto JSON.")

    for user_id in config.get("admin_whitelist", []):
        ADMIN_WHITELIST.add(int(user_id))
    for role_id in config.get("protected_roles", config.get("protected_admin_roles", [])):
        PROTECTED_ROLES.add(int(role_id))


def save_admin_access_config():
    os.makedirs(os.path.dirname(ADMIN_ACCESS_CONFIG), exist_ok=True)
    temp_path = f"{ADMIN_ACCESS_CONFIG}.tmp"
    config = {
        "admin_whitelist": sorted(ADMIN_WHITELIST),
        "protected_roles": sorted(PROTECTED_ROLES),
    }
    with open(temp_path, "w", encoding="utf-8") as config_file:
        json.dump(config, config_file, indent=2)
    os.replace(temp_path, ADMIN_ACCESS_CONFIG)


load_admin_access_config()


def load_profile_history():
    try:
        with open(PROFILE_HISTORY_PATH, encoding="utf-8") as history_file:
            history = json.load(history_file)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as error:
        logger.error("No se pudo leer el historial de perfiles: %s", error)
        raise
    if not isinstance(history, dict):
        raise ValueError("profile_history.json debe contener un objeto JSON.")
    return history


def save_profile_history():
    os.makedirs(os.path.dirname(PROFILE_HISTORY_PATH), exist_ok=True)
    temp_path = f"{PROFILE_HISTORY_PATH}.tmp"
    with open(temp_path, "w", encoding="utf-8") as history_file:
        json.dump(PROFILE_HISTORY, history_file, ensure_ascii=False, indent=2)
    os.replace(temp_path, PROFILE_HISTORY_PATH)


PROFILE_HISTORY = load_profile_history()


def acquire_instance_lock():
    os.makedirs(os.path.dirname(INSTANCE_LOCK_PATH), exist_ok=True)
    lock_file = open(INSTANCE_LOCK_PATH, "a+b")
    lock_file.seek(0, os.SEEK_END)
    if lock_file.tell() == 0:
        lock_file.write(b"\0")
        lock_file.flush()
    lock_file.seek(0)

    try:
        if os.name == "nt":
            import msvcrt

            msvcrt.locking(lock_file.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl

            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        lock_file.close()
        if error.errno in (errno.EACCES, errno.EAGAIN, errno.EDEADLK):
            logger.error("Ya hay otra instancia de Sagss ejecutándose.")
            raise SystemExit(1) from error
        raise

    return lock_file


def load_voice_creator_config():
    try:
        with open(VOICE_CREATOR_CONFIG, encoding="utf-8") as config_file:
            config = json.load(config_file)
    except FileNotFoundError:
        return {}, {}, {}, {}
    except (OSError, json.JSONDecodeError) as error:
        logger.error("No se pudo leer la configuración de voice creator: %s", error)
        raise

    creators = {
        int(guild_id): {int(channel_id) for channel_id in channel_ids}
        for guild_id, channel_ids in config.get("creators", {}).items()
    }
    temporary = {
        int(guild_id): {int(channel_id) for channel_id in channel_ids}
        for guild_id, channel_ids in config.get("temporary", {}).items()
    }
    allowlist = {
        int(guild_id): {int(user_id) for user_id in user_ids}
        for guild_id, user_ids in config.get("allowlist", {}).items()
    }
    owners = {
        int(guild_id): {int(channel_id): int(user_id) for channel_id, user_id in channel_owners.items()}
        for guild_id, channel_owners in config.get("owners", {}).items()
    }
    return creators, temporary, allowlist, owners


def save_voice_creator_config():
    os.makedirs(os.path.dirname(VOICE_CREATOR_CONFIG), exist_ok=True)
    config = {
        "creators": {
            str(guild_id): sorted(channel_ids)
            for guild_id, channel_ids in VOICE_CREATORS.items()
            if channel_ids
        },
        "temporary": {
            str(guild_id): sorted(channel_ids)
            for guild_id, channel_ids in TEMP_VOICE_CHANNELS.items()
            if channel_ids
        },
        "allowlist": {
            str(guild_id): sorted(user_ids)
            for guild_id, user_ids in VOICE_CREATOR_ALLOWLIST.items()
            if user_ids
        },
        "owners": {
            str(guild_id): {str(channel_id): user_id for channel_id, user_id in channel_owners.items()}
            for guild_id, channel_owners in VOICE_CHANNEL_OWNERS.items()
            if channel_owners
        },
    }
    temp_path = f"{VOICE_CREATOR_CONFIG}.tmp"
    with open(temp_path, "w", encoding="utf-8") as config_file:
        json.dump(config, config_file, indent=2)
    os.replace(temp_path, VOICE_CREATOR_CONFIG)


VOICE_CREATORS, TEMP_VOICE_CHANNELS, VOICE_CREATOR_ALLOWLIST, VOICE_CHANNEL_OWNERS = load_voice_creator_config()

